{ 
    "manifest_version": 3,
    "name": "O(note)",
    "version": "5.1",
    "description": "O(note) helps users create, manage, search, and access personal notes associated with DSA problems on LeetCode and Codeforces.",

    "permissions": ["storage","webNavigation"],
    "host_permissions": ["https://leetcode.com/*","https://codeforces.com/*"],
    
    "options_page": "src/options/options.html",

    "background": {
        "service_worker": "src/background/background.js",
        "type": "module"
    },

    "content_scripts": [
        {
            "matches": ["https://leetcode.com/*","https://codeforces.com/*"],
            "js": ["src/content/content.js"],
            "run_at": "document_idle"
        }
    ],

    "web_accessible_resources": [
        {
            "resources": ["src/content/panel.css"],
            "matches": ["https://leetcode.com/*","https://codeforces.com/*"]
        }
    ],

    "commands": {
        "toggle_panel": {
            "suggested_key": {
                "default": "Alt+L"
            },
            "description": "Toggle the notes panel"
        },
        "toggle_mode": {
            "suggested_key": {
                "default": "Alt+K"
            },
            "description": "Toggle the panel mode"
        }
    },

    "action": {
        "default_popup": "src/popup/popup.html",
        "default_title": "O(note)"
    },
    
    "icons": {
        "16": "assets/icon-16.png",
        "48": "assets/icon-48.png",
        "128": "assets/icon-128.png"
    }
}
